#!/usr/bin/env bash
# Install bkt (Linux) — curlable from GitHub Pages
# Usage: /bin/bash -c "$(curl -fsSL https://xentixar.github.io/bkt-builds/install/linux)"
set -euo pipefail

BKT_EXPECT_OS="linux"
BKT_BUILDS_BASE_URL="${BKT_BUILDS_BASE_URL:-https://xentixar.github.io/bkt-builds}"
INSTALL_DIR="${BKT_INSTALL_DIR:-$HOME/.local/bin}"
BIN_NAME="${BKT_BIN_NAME:-bkt}"

uname_s="$(uname -s | tr '[:upper:]' '[:lower:]')"
uname_m="$(uname -m | tr '[:upper:]' '[:lower:]')"

if [[ "$uname_s" != "$BKT_EXPECT_OS" ]]; then
  echo "This installer is for Linux. Detected: $uname_s" >&2
  echo "Use the Mac or Windows installer from https://xentixar.github.io/bkt-builds/" >&2
  exit 1
fi

case "$uname_m" in
  x86_64|amd64) arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "Unsupported arch: $uname_m" >&2; exit 1 ;;
esac

os="linux"
ext=""
mkdir -p "$INSTALL_DIR"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

url_candidates=(
  "${BKT_BUILDS_BASE_URL}/dist/${BIN_NAME}-${os}-${arch}${ext}"
  "${BKT_BUILDS_BASE_URL}/dist/${BIN_NAME}${ext}"
)

download() {
  local url="$1"
  local out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --retry-delay 1 -o "$out" "$url"
    return 0
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
    return 0
  fi
  echo "Install curl or wget, then re-run this script." >&2
  exit 1
}

src=""
for u in "${url_candidates[@]}"; do
  if download "$u" "$tmp/$BIN_NAME$ext" >/dev/null 2>&1; then
    src="$u"
    break
  fi
done

if [[ -z "$src" ]]; then
  echo "No build found for ${os}/${arch}." >&2
  echo "Publish binaries to: ${BKT_BUILDS_BASE_URL}/dist/" >&2
  for u in "${url_candidates[@]}"; do echo "  tried: $u" >&2; done
  exit 1
fi

chmod +x "$tmp/$BIN_NAME$ext"
install_path="${INSTALL_DIR%/}/${BIN_NAME}${ext}"
mv -f "$tmp/$BIN_NAME$ext" "$install_path"

echo ""
echo "✓ Installed ${BIN_NAME} → ${install_path}"
echo "  Source: ${src}"
echo ""
case ":$PATH:" in
  *":${INSTALL_DIR}:"*) echo "✓ ${INSTALL_DIR} is already on your PATH." ;;
  *) echo "Add to PATH (bash/zsh), then open a new terminal:"; echo "  export PATH=\"${INSTALL_DIR}:\$PATH\"" ;;
esac
echo ""
echo "Next: ${BIN_NAME} version"
echo "      ${BIN_NAME} auth login --app-password"
echo ""
