#!/usr/bin/env bash
# Install bkt (macOS) — curlable from GitHub Pages
# Usage: /bin/bash -c "$(curl -fsSL https://xentixar.github.io/bkt-builds/install/mac)"
set -euo pipefail

BKT_EXPECT_OS="darwin"
BKT_BUILDS_BASE_URL="${BKT_BUILDS_BASE_URL:-https://xentixar.github.io/bkt-builds}"
BKT_RELEASE_REPO="${BKT_RELEASE_REPO:-xentixar/bkt-builds}"
GH_API_BASE="${GH_API_BASE:-https://api.github.com}"
INSTALL_DIR="${BKT_INSTALL_DIR:-$HOME/.local/bin}"
BIN_NAME="${BKT_BIN_NAME:-bkt}"

uname_s="$(uname -s | tr '[:upper:]' '[:lower:]')"
uname_m="$(uname -m | tr '[:upper:]' '[:lower:]')"

if [[ "$uname_s" != "$BKT_EXPECT_OS" ]]; then
  echo "This installer is for macOS. Detected: $uname_s" >&2
  echo "Use the Linux or Windows installer from https://xentixar.github.io/bkt-builds/" >&2
  exit 1
fi

case "$uname_m" in
  x86_64|amd64) arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "Unsupported arch: $uname_m" >&2; exit 1 ;;
esac

os="darwin"
ext=""
mkdir -p "$INSTALL_DIR"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

download() {
  local url="$1"
  local out="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --retry-delay 1 -o "$out" "$url"
    return 0
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO "$out" "$url"
    return 0
  fi
  echo "Install curl or wget, then re-run this script." >&2
  exit 1
}

asset_name="${BIN_NAME}-${os}-${arch}${ext}"
api_url="${GH_API_BASE}/repos/${BKT_RELEASE_REPO}/releases/latest"
src=""

if command -v curl >/dev/null 2>&1; then
  src="$(curl -fsSL "$api_url" | sed -n "s|.*\"browser_download_url\": \"\\([^\"]*${asset_name}\\)\".*|\\1|p" | head -n1)"
elif command -v wget >/dev/null 2>&1; then
  src="$(wget -qO- "$api_url" | sed -n "s|.*\"browser_download_url\": \"\\([^\"]*${asset_name}\\)\".*|\\1|p" | head -n1)"
fi

if [[ -n "$src" ]]; then
  download "$src" "$tmp/$BIN_NAME$ext" >/dev/null 2>&1 || src=""
fi

if [[ -z "$src" ]]; then
  echo "No release asset found for ${asset_name} in ${BKT_RELEASE_REPO}." >&2
  echo "Expected latest release asset name: ${asset_name}" >&2
  echo "Releases URL: https://github.com/${BKT_RELEASE_REPO}/releases" >&2
  exit 1
fi

chmod +x "$tmp/$BIN_NAME$ext"
install_path="${INSTALL_DIR%/}/${BIN_NAME}${ext}"
mv -f "$tmp/$BIN_NAME$ext" "$install_path"

echo ""
echo "✓ Installed ${BIN_NAME} → ${install_path}"
echo "  Source: ${src}"
echo ""
case ":$PATH:" in
  *":${INSTALL_DIR}:"*) echo "✓ ${INSTALL_DIR} is already on your PATH." ;;
  *) echo "Add to PATH (bash/zsh), then open a new terminal:"; echo "  export PATH=\"${INSTALL_DIR}:\$PATH\"" ;;
esac
echo ""
echo "Next: ${BIN_NAME} version"
echo "      ${BIN_NAME} auth login --app-password"
echo ""
